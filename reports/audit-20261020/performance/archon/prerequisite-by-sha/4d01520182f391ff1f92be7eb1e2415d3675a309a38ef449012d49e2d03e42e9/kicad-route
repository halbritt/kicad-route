#!/usr/bin/python3
"""Run the source checkout with the system Python that provides KiCad's pcbnew bindings."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True  # no __pycache__ under the checkout (it may be STATE)

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from kicad_route.cli import main

raise SystemExit(main())
