{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/halbritt/kicad-route/schemas/result-1.json",
  "title": "kicad-route result records, major version 1",
  "description": "The records kicad-route writes and prints with --json: route (run_dir/result.json), route-validate (revalidate*/<stamp>/result.json) and route-campaign (campaign.json). Only the stable fields are constrained; other fields are informational and may change within /1 (docs/interface.md). Refusals (exit 4) are schemas/refusal-1.json.",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "enum": [
        "kicad-route/route/1",
        "kicad-route/route-validate/1",
        "kicad-route/route-campaign/1"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/route"
    },
    {
      "$ref": "#/$defs/route-validate"
    },
    {
      "$ref": "#/$defs/route-campaign"
    }
  ],
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "exit_code",
        "backend",
        "input",
        "settings",
        "scope",
        "unsupported",
        "process",
        "routing",
        "validation",
        "candidate",
        "run_dir",
        "ledger"
      ],
      "properties": {
        "schema": {
          "const": "kicad-route/route/1"
        },
        "kind": {
          "const": "route"
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "deprecated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "replaced_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "backend": {
          "type": "object",
          "required": [
            "name",
            "version",
            "build"
          ],
          "properties": {
            "name": {
              "enum": [
                "krt",
                "freerouting"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "build": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "rust_router": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "input": {
          "type": "object",
          "required": [
            "project",
            "board",
            "fingerprint",
            "source_git_head"
          ],
          "properties": {
            "project": {
              "type": "string"
            },
            "board": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_git_head": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "settings": {
          "type": "object",
          "required": [
            "backend",
            "budget_s",
            "protect",
            "mode",
            "backend_args",
            "backend_env"
          ],
          "properties": {
            "backend": {
              "enum": [
                "krt",
                "freerouting"
              ]
            },
            "budget_s": {
              "type": "integer"
            },
            "protect": {
              "enum": [
                "existing",
                "locked",
                "human"
              ]
            },
            "mode": {
              "enum": [
                "all",
                "selected"
              ]
            },
            "max_iterations": {
              "type": [
                "integer",
                "null"
              ]
            },
            "passes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "default_clearance_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "clearance_margin_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "pour_area_loss_pct": {
              "type": [
                "number",
                "null"
              ]
            },
            "pour_min_spokes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "backend_args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "backend_env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "reserve_spokes": {
              "type": [
                "integer",
                "null"
              ]
            },
            "stall_s": {
              "type": [
                "integer",
                "null"
              ]
            },
            "net_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "netclasses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rule_floor_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "scope": {
          "type": "object",
          "required": [
            "mode",
            "nets"
          ],
          "properties": {
            "mode": {
              "enum": [
                "all",
                "selected"
              ]
            },
            "nets": {
              "type": "integer",
              "minimum": 1
            },
            "nets_list": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "process": {
          "type": "object",
          "required": [
            "status",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "measurement_qualification": {
              "type": "object",
              "required": [
                "measurement",
                "build_reproducible",
                "reasons"
              ],
              "properties": {
                "measurement": {
                  "type": "boolean"
                },
                "build_reproducible": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "routing": {
          "$ref": "#/$defs/routing"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "candidate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "dir",
                "board"
              ],
              "properties": {
                "dir": {
                  "type": "string"
                },
                "board": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "run_dir": {
          "type": "string"
        },
        "ledger": {
          "type": "object",
          "required": [
            "fingerprint"
          ],
          "properties": {
            "fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "process": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "routing": {
                "properties": {
                  "status": {
                    "const": "COMPLETE"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "validation": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "candidate": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "process": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "routing": {
                "properties": {
                  "status": {
                    "const": "INCOMPLETE"
                  }
                },
                "required": [
                  "status",
                  "blocked_by"
                ]
              },
              "validation": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "candidate": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "process": {
                "properties": {
                  "status": {
                    "const": "FAIL"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "routing": {
                "properties": {
                  "status": {
                    "const": "NOT_RUN"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "validation": {
                "properties": {
                  "status": {
                    "const": "NOT_RUN"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "candidate": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "process": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "validation": {
                "properties": {
                  "status": {
                    "const": "FAIL"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "candidate": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "route-validate": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "exit_code",
        "run_dir",
        "against",
        "routing",
        "validation"
      ],
      "properties": {
        "schema": {
          "const": "kicad-route/route-validate/1"
        },
        "kind": {
          "const": "route-validate"
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "deprecated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "replaced_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "run_dir": {
          "type": "string"
        },
        "against": {
          "type": [
            "string",
            "null"
          ]
        },
        "dir": {
          "type": "string"
        },
        "routing": {
          "$ref": "#/$defs/routing"
        },
        "validation": {
          "$ref": "#/$defs/validation"
        },
        "process": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "measurement_qualification": {
              "type": "object",
              "required": [
                "measurement",
                "build_reproducible",
                "reasons"
              ],
              "properties": {
                "measurement": {
                  "type": "boolean"
                },
                "build_reproducible": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "routing": {
                "properties": {
                  "status": {
                    "const": "COMPLETE"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "validation": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "process": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "routing": {
                "properties": {
                  "status": {
                    "const": "INCOMPLETE"
                  }
                },
                "required": [
                  "status",
                  "blocked_by"
                ]
              },
              "validation": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "process": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "routing": {
                "properties": {
                  "status": {
                    "const": "NOT_RUN"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "validation": {
                "properties": {
                  "status": {
                    "const": "NOT_RUN"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "process": {
                "properties": {
                  "status": {
                    "const": "FAIL"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 3
              }
            }
          },
          "then": {
            "properties": {
              "validation": {
                "properties": {
                  "status": {
                    "const": "FAIL"
                  }
                }
              },
              "process": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "route-campaign": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "exit_code",
        "campaign_dir",
        "input",
        "best",
        "stop_reason",
        "leaderboard"
      ],
      "properties": {
        "schema": {
          "const": "kicad-route/route-campaign/1"
        },
        "kind": {
          "const": "route-campaign"
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "deprecated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "replaced_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "since": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "campaign_dir": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "required": [
            "fingerprint"
          ],
          "properties": {
            "fingerprint": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "leaderboard": {
          "type": "array"
        },
        "best": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "chain",
                "run_dir",
                "candidate",
                "grade",
                "exit_code"
              ],
              "properties": {
                "chain": {
                  "type": "string"
                },
                "run_dir": {
                  "type": "string"
                },
                "candidate": {
                  "type": "string"
                },
                "grade": {
                  "type": "string"
                },
                "exit_code": {
                  "enum": [
                    0,
                    2,
                    3,
                    1
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exit_code": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "best": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "exit_code": {
                "enum": [
                  0,
                  2,
                  3
                ]
              }
            }
          },
          "then": {
            "properties": {
              "best": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "routing": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "NOT_RUN"
          ]
        },
        "unconnected_in_scope": {
          "type": "integer",
          "minimum": 0
        },
        "unconnected_total": {
          "type": "integer",
          "minimum": 0
        },
        "unrouted_nets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stats": {
          "type": "object"
        },
        "blocked_by": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "COMPLETE",
                  "INCOMPLETE"
                ]
              }
            }
          },
          "then": {
            "required": [
              "unconnected_in_scope",
              "unrouted_nets"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETE"
              }
            }
          },
          "then": {
            "properties": {
              "unconnected_in_scope": {
                "const": 0
              },
              "unrouted_nets": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INCOMPLETE"
              }
            }
          },
          "then": {
            "properties": {
              "unconnected_in_scope": {
                "minimum": 1
              },
              "unrouted_nets": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parity_performed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delivered_board_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "validated_board_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_board_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "refill_modified_board": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "preservation": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "UNSUPPORTED"
            ]
          }
        },
        "drc": {
          "type": "object"
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dir": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "required": [
              "delivered_board_sha256",
              "validated_board_sha256",
              "candidate_board_sha256",
              "preservation"
            ],
            "properties": {
              "reasons": {
                "maxItems": 0
              },
              "delivered_board_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "validated_board_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "candidate_board_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "preservation": {
                "additionalProperties": {
                  "const": "PASS"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "FAIL",
                  "NOT_RUN"
